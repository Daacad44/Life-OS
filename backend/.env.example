NODE_ENV=development
PORT=4000

# Postgres (see prisma/schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/life_os?schema=public"

# Redis (sessions, cache, queues)
REDIS_URL="redis://localhost:6379"

# Session cookie signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="change-me"

# Google Gemini API (server-side only, never exposed to the frontend).
# In production (Coolify) set GEMINI_API_KEY as a runtime variable; the backend
# refuses to start without it. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Main chat/completions model. Override to a Pro-tier model for deeper reasoning.
GEMINI_MODEL="gemini-3.6-flash"
# Embedding model for AI memory. Its output width must match GEMINI_EMBEDDING_DIM,
# which must match MemoryItem.embedding's vector() width in prisma/schema.prisma.
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIM="1536"

# Must match the deployed frontend origin
CORS_ORIGIN="http://localhost:5173"

# Cloudflare R2 object storage for user-uploaded assets — currently the custom
# alarm ringtone. Leave blank to disable uploads (the app falls back to preset
# alarm chimes and the upload endpoint returns 501). R2 speaks the S3 API.
R2_ENDPOINT=""            # https://<account_id>.r2.cloudflarestorage.com
R2_REGION="auto"
R2_BUCKET=""
R2_ACCESS_KEY_ID=""       # from an R2 API token (Object Read & Write)
R2_SECRET_ACCESS_KEY=""
# Public base URL the bucket is served from — an R2 public bucket URL
# (https://pub-<hash>.r2.dev) or a custom domain. Object keys are appended.
R2_PUBLIC_URL=""
