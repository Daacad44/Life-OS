// Foundation schema — see docs/Life-OS-Blueprint/Life-OS-Blueprint/03-Architecture/Database.md
// Each feature PRD extends this with its own models, following the same conventions:
// UUID primary keys, userId scoping, createdAt/updatedAt, soft deletes where needed.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  name                    String?
  passwordHash            String?
  role                    Role     @default(USER)
  timezone                String   @default("UTC")
  // Per-category opt in/out, e.g. {"habitMilestones": true, "budgetThreshold": true, "weeklyReview": true}.
  // Missing keys default to "on" in application code — see Notifications.md Section 9.
  notificationPreferences Json?
  // Community is strictly opt-in — see Community.md Section 9.
  communityOptIn          Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tasks         Task[]
  goals         Goal[]
  habits        Habit[]
  events        CalendarEvent[]
  notes         Note[]
  memories      MemoryItem[]
  notifications Notification[]
  coachMessages CoachMessage[]
  reflections   Reflection[]
  aiUsageLogs   AiUsageLog[]
  weeklyReviews WeeklyReview[]
  transactions  Transaction[]
  budgets       Budget[]
  focusSessions FocusSession[]

  healthLogs           HealthLog[]
  subjects             Subject[]
  studySessions        StudySession[]
  careerGoals          CareerGoal[]
  skills               Skill[]
  milestones           Milestone[]
  projects             Project[]
  clients              Client[]
  automations          Automation[]
  recommendations      Recommendation[]
  progress             UserProgress?
  achievements         Achievement[]
  connectionsRequested Connection[]     @relation("ConnectionRequester")
  connectionsReceived  Connection[]     @relation("ConnectionPartner")
  sharedGoals          SharedGoal[]
  communityPosts       CommunityPost[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  priority      Priority       @default(MEDIUM)
  dueDate       DateTime?
  order         Int            @default(0)
  goalId        String?
  goal          Goal?          @relation(fields: [goalId], references: [id])
  // A task linked to a Project is a business task — see Business Workspace.md Section 7.
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  focusSessions FocusSession[]

  @@index([userId])
  @@index([status])
}

model Goal {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  progress     Int           @default(0)
  targetDate   DateTime?
  tasks        Task[]
  subGoals     SubGoal[]
  transactions Transaction[]
  sharedGoal   SharedGoal?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([userId])
}

model SubGoal {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

model Habit {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  frequency HabitFrequency @default(DAILY)
  streak    Int            @default(0)
  checkins  HabitCheckin[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

model HabitCheckin {
  id      String   @id @default(uuid())
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime @default(now())
  done    Boolean  @default(true)
}

model CalendarEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  startTime DateTime
  endTime   DateTime
  allDay    Boolean  @default(false)
  taskId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startTime])
}

model Note {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  tags      String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// AI memory — see docs/.../03-Architecture/AI Architecture.md
// embedding dimension (1024) matches Voyage AI's voyage-3.5 default output — verified live.
model MemoryItem {
  id         String                       @id @default(uuid())
  userId     String
  user       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  type       String // fact, preference, event, summary, note
  embedding  Unsupported("vector(1024)")?
  // Links a memory back to its origin record (e.g. a Note) for AI Search — null for
  // memories extracted from conversation/reflection, which have no single source entity.
  sourceType String?
  sourceId   String?
  createdAt  DateTime                     @default(now())

  @@index([userId])
  @@index([sourceType, sourceId])
}

enum CoachRole {
  USER
  ASSISTANT
}

model CoachMessage {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CoachRole
  content   String
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Reflection {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    String // daily, weekly
  prompt    String
  content   String
  insights  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AiUsageLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String // coach, goal_breakdown, habit_insight, reflection, memory_embed
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// AI Weekly Review — see docs/.../02-PRD/Weekly Review.md
model WeeklyReview {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart    DateTime // Sunday, midnight UTC — identifies the week (one review per week)
  summary      String
  wins         String[] @default([])
  focusAreas   String[] @default([])
  nextWeekPlan String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, weekStart])
}

// Finance Planner — see docs/.../02-PRD/Finance Planner.md
enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TransactionType
  amount    Decimal         @db.Decimal(12, 2)
  category  String
  note      String?
  date      DateTime
  goalId    String?
  goal      Goal?           @relation(fields: [goalId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  @@index([userId, date])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  period    String   @default("monthly") // only "monthly" is supported for now
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, period])
}

// Focus Mode — see docs/.../02-PRD/Focus Mode.md
model FocusSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  duration  Int? // seconds — set when the session ends

  @@index([userId, startedAt])
}

// Health Tracker — see docs/.../02-PRD/Health.md
enum HealthMetricType {
  SLEEP
  WATER
  EXERCISE
  MOOD
  WEIGHT
}

model HealthLog {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      HealthMetricType
  value     Float
  date      DateTime
  createdAt DateTime         @default(now())

  @@index([userId, type, date])
}

// Study Planner — see docs/.../02-PRD/Study Planner.md
model Subject {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  progress      Int            @default(0)
  studySessions StudySession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([userId])
}

model StudySession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic       String?
  scheduledAt DateTime
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, scheduledAt])
}

// Career Planner — see docs/.../02-PRD/Career Planner.md
model CareerGoal {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  targetRole  String?
  description String?
  milestones  Milestone[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([userId])
}

model Skill {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Milestone {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerGoalId String?
  careerGoal   CareerGoal? @relation(fields: [careerGoalId], references: [id], onDelete: Cascade)
  title        String
  done         Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([userId])
}

// Business Workspace — see docs/.../02-PRD/Business Workspace.md
enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Project {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  status    ProjectStatus @default(ACTIVE)
  tasks     Task[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

model Client {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  details   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

// Workflow Automation — see docs/.../02-PRD/Workflow Automation.md
// "weekly" triggers are stored but not executed — there is no background job
// scheduler yet. habit_checkin / goal_progress run synchronously from the
// triggering request, same pattern as the Notifications Intelligence triggers.
model Automation {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  trigger       String // habit_checkin | goal_progress | weekly
  triggerConfig Json
  action        String // create_task | notify
  actionConfig  Json
  enabled       Boolean         @default(true)
  lastRunAt     DateTime?
  runs          AutomationRun[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
}

model AutomationRun {
  id           String     @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  ranAt        DateTime   @default(now())
  success      Boolean
  note         String?

  @@index([automationId, ranAt])
}

// Smart Recommendations — see docs/.../02-PRD/Smart Recommendations.md
enum RecommendationStatus {
  ACTIVE
  ACCEPTED
  DISMISSED
}

model Recommendation {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  content   String
  status    RecommendationStatus @default(ACTIVE)
  createdAt DateTime             @default(now())

  @@index([userId, status])
}

// Gamification — see docs/.../02-PRD/Gamification.md
model UserProgress {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Achievement {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  unlockedAt DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

// Community — see docs/.../02-PRD/Community.md
enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Connection {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("ConnectionRequester", fields: [userId], references: [id], onDelete: Cascade)
  partnerId String
  partner   User             @relation("ConnectionPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  status    ConnectionStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, partnerId])
  @@index([partnerId])
}

enum ShareVisibility {
  PRIVATE
  PARTNERS
  PUBLIC
}

model SharedGoal {
  id         String          @id @default(uuid())
  goalId     String          @unique
  goal       Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibility ShareVisibility @default(PARTNERS)
  createdAt  DateTime        @default(now())
}

model CommunityPost {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String
  sharedGoalId String?
  reported     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
