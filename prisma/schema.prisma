// Foundation schema — see docs/Life-OS-Blueprint/Life-OS-Blueprint/03-Architecture/Database.md
// Each feature PRD extends this with its own models, following the same conventions:
// UUID primary keys, userId scoping, createdAt/updatedAt, soft deletes where needed.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  name                    String?
  passwordHash            String?
  role                    Role     @default(USER)
  timezone                String   @default("UTC")
  // Per-category opt in/out, e.g. {"habitMilestones": true, "budgetThreshold": true, "weeklyReview": true}.
  // Missing keys default to "on" in application code — see Notifications.md Section 9.
  notificationPreferences Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tasks         Task[]
  goals         Goal[]
  habits        Habit[]
  events        CalendarEvent[]
  notes         Note[]
  memories      MemoryItem[]
  notifications Notification[]
  coachMessages CoachMessage[]
  reflections   Reflection[]
  aiUsageLogs   AiUsageLog[]
  weeklyReviews WeeklyReview[]
  transactions  Transaction[]
  budgets       Budget[]
  focusSessions FocusSession[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  priority      Priority       @default(MEDIUM)
  dueDate       DateTime?
  order         Int            @default(0)
  goalId        String?
  goal          Goal?          @relation(fields: [goalId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  focusSessions FocusSession[]

  @@index([userId])
  @@index([status])
}

model Goal {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  progress     Int           @default(0)
  targetDate   DateTime?
  tasks        Task[]
  subGoals     SubGoal[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([userId])
}

model SubGoal {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

model Habit {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  frequency HabitFrequency @default(DAILY)
  streak    Int            @default(0)
  checkins  HabitCheckin[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

model HabitCheckin {
  id      String   @id @default(uuid())
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime @default(now())
  done    Boolean  @default(true)
}

model CalendarEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  startTime DateTime
  endTime   DateTime
  allDay    Boolean  @default(false)
  taskId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startTime])
}

model Note {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  tags      String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// AI memory — see docs/.../03-Architecture/AI Architecture.md
// embedding dimension (1024) matches Voyage AI's voyage-3.5 default output — verified live.
model MemoryItem {
  id         String                       @id @default(uuid())
  userId     String
  user       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  type       String // fact, preference, event, summary, note
  embedding  Unsupported("vector(1024)")?
  // Links a memory back to its origin record (e.g. a Note) for AI Search — null for
  // memories extracted from conversation/reflection, which have no single source entity.
  sourceType String?
  sourceId   String?
  createdAt  DateTime                     @default(now())

  @@index([userId])
  @@index([sourceType, sourceId])
}

enum CoachRole {
  USER
  ASSISTANT
}

model CoachMessage {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CoachRole
  content   String
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Reflection {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period     String // daily, weekly
  prompt     String
  content    String
  insights   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model AiUsageLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String // coach, goal_breakdown, habit_insight, reflection, memory_embed
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// AI Weekly Review — see docs/.../02-PRD/Weekly Review.md
model WeeklyReview {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart    DateTime // Sunday, midnight UTC — identifies the week (one review per week)
  summary      String
  wins         String[] @default([])
  focusAreas   String[] @default([])
  nextWeekPlan String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, weekStart])
}

// Finance Planner — see docs/.../02-PRD/Finance Planner.md
enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TransactionType
  amount    Decimal         @db.Decimal(12, 2)
  category  String
  note      String?
  date      DateTime
  goalId    String?
  goal      Goal?           @relation(fields: [goalId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  @@index([userId, date])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  period    String   @default("monthly") // only "monthly" is supported for now
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, period])
}

// Focus Mode — see docs/.../02-PRD/Focus Mode.md
model FocusSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  duration  Int? // seconds — set when the session ends

  @@index([userId, startedAt])
}
